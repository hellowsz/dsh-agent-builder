{
  "name": "@dsh-agent-builder/gate-plugin",
  "version": "0.0.1",
  "type": "module",
  "description": "DSH 运行时门禁插件：agent/turn-stopping 拦截 + 不合格 steer 重试限次",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/gate-plugin.mjs"
  },
  "dependencies": {
    "@dsh-agent-builder/gate-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "esbuild": "^0.24.0"
  }
}