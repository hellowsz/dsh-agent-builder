{
  "name": "@dsh-agent-builder/collector",
  "version": "0.0.1",
  "type": "module",
  "description": "开源插件收集器：定时全网筛选 DSH 相关插件，产出面向 AI 检索的清单",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "collect": "tsx src/collect.ts",
    "build": "esbuild src/collect.ts --bundle --format=esm --platform=node --target=node22 --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/collect.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0"
  }
}